{
  "manifest_version": 3,
  "name": "Image Upscaler",
  "version": "1.1.0",
  "description": "Automatically removes the corner sparkle mark and upscales images 2x, with a before/after quality slider. Runs fully offline in your browser.",
  "minimum_chrome_version": "103",
  "action": {
    "default_title": "Open Image Upscaler",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
