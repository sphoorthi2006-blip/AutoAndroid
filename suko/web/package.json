{
  "name": "suko-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node tests/units.test.mjs && node tests/bridge.test.mjs && node tests/text.test.mjs && node tests/export.test.mjs && node tests/textslide.test.mjs && node tests/clips.test.mjs && node tests/scenes.test.mjs",
    "build:desktop": "tsc --noEmit && vite build --config vite.desktop.config.ts",
    "build:extension": "tsc --noEmit && vite build --config vite.extension.config.ts",
    "build:suko": "tsc --noEmit && vite build --config vite.suko.config.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-math": "^5.3.0",
    "@types/opentype.js": "^1.3.10",
    "jszip": "^3.10.1",
    "mp4-muxer": "^5.2.2",
    "opentype.js": "^1.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^31.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
