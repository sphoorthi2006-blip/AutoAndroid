<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@style/Theme.Bezalel">

        <!-- Home screen: the two tools -->
        <activity
            android:name="com.suko.app.HubActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Web host (steps 16-18): shows pages from assets/web, offline only. The app has no INTERNET permission. -->
        <activity
            android:name="com.suko.app.web.WebHostActivity"
            android:label="Web"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|layoutDirection|fontScale" />

        <!-- Step 30: keeps long exports running with the screen off -->
        <service android:name="com.suko.app.web.ExportKeepAliveService" android:exported="false" android:foregroundServiceType="dataSync" />

        <!-- Intake test (step 8) -->
        <activity
            android:name="com.suko.app.IntakeTestActivity"
            android:label="Intake test"
            android:exported="false" />

        <!-- Auto Editor (code package is still com.cuevideo.app; the name users see is only "Auto Editor") -->
        <activity
            android:name="com.cuevideo.app.MainActivity"
            android:label="Auto Editor"
            android:exported="false" />
    </application>
</manifest>
