+            Text("Deletes the imported copies, extracted pictures and old exports in the app's temporary folder, and closes the current project. Videos already saved in Movies/Auto are kept.", color = C.Muted, fontSize = 13.sp, modifier = Modifier.padding(top = 4.dp, bottom = 12.dp))
+            val shape = RoundedCornerShape(50)
+            Box(Modifier.fillMaxWidth().clip(shape).border(1.dp, C.Line, shape).clickable {
+                st.clearTemp { n -> shell.message("Temporary files cleared", "Freed ${size(n)}. Import your files again to continue.") }
+            }.padding(vertical = 13.dp), contentAlignment = Alignment.Center) { Text("Clear temporary files", color = Color.White, fontWeight = FontWeight.Bold, fontSize = 14.sp) }
+        }
+        Spacer(Modifier.height(10.dp))
+        Column(Modifier.fillMaxWidth().clip(card).background(C.Card).border(1.dp, C.Line, card).padding(16.dp)) {
+            Text("About", color = C.Text, fontWeight = FontWeight.Bold, fontSize = 16.sp)
+            Text("Auto 0.2", color = C.Text, fontSize = 14.sp, modifier = Modifier.padding(top = 4.dp))
+            Text("Export: MP4 (H.264 + AAC), 720p / 1080p / 4K, 16:9 · 9:16 · 1:1 · 4:5, 24 / 30 / 60 fps in the engine (the sheet offers 30 and 60).", color = C.Muted, fontSize = 13.sp, modifier = Modifier.padding(top = 4.dp))
+        }
+    }
+}
+
+private fun size(b: Long): String = when {
+    b < 1024 -> "$b B"
+    b < 1024L * 1024 -> String.format(java.util.Locale.ROOT, "%.1f KB", b / 1024.0)
+    b < 1024L * 1024 * 1024 -> String.format(java.util.Locale.ROOT, "%.1f MB", b / 1048576.0)
+    else -> String.format(java.util.Locale.ROOT, "%.2f GB", b / 1073741824.0)
+}
diff --git a/core/src/main/kotlin/com/auto/core/ExportOptions.kt b/core/src/main/kotlin/com/auto/core/ExportOptions.kt
new file mode 100644
index 0000000..6bb4882
--- /dev/null
+++ b/core/src/main/kotlin/com/auto/core/ExportOptions.kt
@@ -0,0 +1,29 @@
+package com.auto.core
+
+import kotlin.math.roundToInt
+
+/** Output resolution = length of the SHORTER side in pixels (720p, 1080p, 4K = 2160). */
+enum class Resolution(val label: String, val shortSide: Int) { P720("720p", 720), P1080("1080p", 1080), P2160("4K", 2160);
+    companion object { fun of(heightP: Int) = values().firstOrNull { it.shortSide == heightP } ?: throw IllegalArgumentException("Resolution must be 720, 1080 or 2160 (4K).") }
+}
+
+/** Aspect ratio as width:height. Pictures that do not match are scaled to fit (black bars) by the exporter. */
+enum class AspectRatio(val label: String, val w: Int, val h: Int) {
+    R16_9("16:9", 16, 9), R9_16("9:16", 9, 16), R1_1("1:1", 1, 1), R4_5("4:5", 4, 5);
+    val ratio get() = w.toFloat() / h
+}
+
+/** Resolution x aspect ratio -> even pixel width/height (video encoders need even sizes). 16:9 gives exactly the old presets. */
+object ExportOptions {
+    private fun even(v: Double): Int { val n = v.roundToInt(); return if (n % 2 == 0) n else n + 1 }
+
+    fun size(res: Resolution, aspect: AspectRatio): Pair<Int, Int> {
+        val s = res.shortSide
+        return if (aspect.w >= aspect.h) Pair(even(s.toDouble() * aspect.w / aspect.h), s)
+        else Pair(s, even(s.toDouble() * aspect.h / aspect.w))
+    }
+
+    fun settings(res: Resolution, aspect: AspectRatio, fps: Int = 30): ExportSettings {
+        val (w, h) = size(res, aspect); return ExportSettings(w, h, fps)
+    }
+}
diff --git a/core/src/test/kotlin/Check14.kt b/core/src/test/kotlin/Check14.kt
new file mode 100644
index 0000000..8dab6ce
--- /dev/null
+++ b/core/src/test/kotlin/Check14.kt
@@ -0,0 +1,35 @@
+import com.auto.core.*
+
+var fails14 = 0
+fun ok14(name: String, cond: Boolean) { println((if (cond) "PASS " else "FAIL ") + name); if (!cond) fails14++ }
+
+/** Export shapes: resolution x aspect ratio -> pixel sizes, and 16:9 must equal the existing presets. */
+fun main() {
+    fun sz(r: Resolution, a: AspectRatio) = ExportOptions.size(r, a)
+    ok14("720p 16:9 = 1280x720", sz(Resolution.P720, AspectRatio.R16_9) == Pair(1280, 720))
+    ok14("720p 9:16 = 720x1280", sz(Resolution.P720, AspectRatio.R9_16) == Pair(720, 1280))
+    ok14("720p 1:1 = 720x720", sz(Resolution.P720, AspectRatio.R1_1) == Pair(720, 720))
+    ok14("720p 4:5 = 720x900", sz(Resolution.P720, AspectRatio.R4_5) == Pair(720, 900))
+    ok14("1080p 16:9 = 1920x1080", sz(Resolution.P1080, AspectRatio.R16_9) == Pair(1920, 1080))
+    ok14("1080p 9:16 = 1080x1920", sz(Resolution.P1080, AspectRatio.R9_16) == Pair(1080, 1920))
+    ok14("1080p 1:1 = 1080x1080", sz(Resolution.P1080, AspectRatio.R1_1) == Pair(1080, 1080))
+    ok14("1080p 4:5 = 1080x1350", sz(Resolution.P1080, AspectRatio.R4_5) == Pair(1080, 1350))
+    ok14("4K 16:9 = 3840x2160", sz(Resolution.P2160, AspectRatio.R16_9) == Pair(3840, 2160))
+    ok14("4K 9:16 = 2160x3840", sz(Resolution.P2160, AspectRatio.R9_16) == Pair(2160, 3840))
+    ok14("4K 4:5 = 2160x2700", sz(Resolution.P2160, AspectRatio.R4_5) == Pair(2160, 2700))
+    var allEven = true; var allValid = true
+    for (r in Resolution.values()) for (a in AspectRatio.values()) for (f in ExportSettings.FPS) {
+        val (w, h) = sz(r, a); if (w % 2 != 0 || h % 2 != 0) allEven = false
+        try { ExportOptions.settings(r, a, f) } catch (e: Exception) { allValid = false }
+    }
+    ok14("every offered size is even", allEven)
+    ok14("every combination builds valid ExportSettings (24/30/60 fps)", allValid)
+    ok14("16:9 equals the existing P720 / P1080 / P4K presets", ExportOptions.settings(Resolution.P720, AspectRatio.R16_9) == ExportSettings.P720 && ExportOptions.settings(Resolution.P1080, AspectRatio.R16_9) == ExportSettings.P1080 && ExportOptions.settings(Resolution.P2160, AspectRatio.R16_9) == ExportSettings.P4K)
+    ok14("16:9 equals ExportSettings.preset at 60 fps", ExportOptions.settings(Resolution.P1080, AspectRatio.R16_9, 60) == ExportSettings.preset(1080, 60))
+    ok14("Resolution.of maps 720/1080/2160", Resolution.of(720) == Resolution.P720 && Resolution.of(1080) == Resolution.P1080 && Resolution.of(2160) == Resolution.P2160)
+    ok14("Resolution.of refuses other heights", try { Resolution.of(480); false } catch (e: IllegalArgumentException) { true })
+    ok14("bad fps is refused", try { ExportOptions.settings(Resolution.P720, AspectRatio.R16_9, 25); false } catch (e: IllegalArgumentException) { true })
+    ok14("ratio values", AspectRatio.R16_9.ratio > 1f && AspectRatio.R9_16.ratio < 1f && AspectRatio.R1_1.ratio == 1f && AspectRatio.R4_5.ratio == 0.8f)
+    println(if (fails14 == 0) "ALL PASS" else "FAILED $fails14")
+    if (fails14 > 0) kotlin.system.exitProcess(1)
+}
