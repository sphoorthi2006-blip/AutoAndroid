+fun SettingsScreen(st: AutoState, shell: Shell) {
+    val card = RoundedCornerShape(20.dp)
+    Column(Modifier.fillMaxSize().background(C.Bg).verticalScroll(rememberScrollState()).statusBarsPadding().padding(horizontal = 16.dp)) {
